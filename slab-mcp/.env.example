# --- Credentials: set ONE of the two below --------------------------------
#
# Either way the key is never a tool argument, so the model cannot read it out
# of the API surface. What differs is whether the key is sitting in a config
# file the agent could read some other way.
#
# 1) The key itself. Simple; right for CI, containers, and machines with no
#    secret manager.
SLAB_API_KEY=sk_live_your_key_here
#
# 2) PREFERRED for a workstation: a command that PRINTS the key. Your MCP
#    config then holds an instruction rather than a credential. Examples:
#      macOS Keychain: security find-generic-password -s slab-mcp -w
#      1Password:      op read "op://Private/slab/credential"
#      pass:           pass show slab/api-key
# SLAB_API_KEY_COMMAND=security find-generic-password -s slab-mcp -w
#
# If both are set, SLAB_API_KEY wins and the server logs which source it used.
# Don't inline a secret in the command — a failing command is echoed back in
# the error so you can debug it.

# Optional. Defaults to https://api.slab.dev-jeb.com
SLAB_API_URL=https://api.slab.dev-jeb.com

# Optional. The collector the key acts for. Omit and the server resolves your
# account's default collector once, on the first call that needs one.
SLAB_COLLECTOR=

# Optional. Unset/0 = read-only (the default). Set to 1 to also register the
# write tools (add/update/remove copies, log breaks and lots).
SLAB_MCP_WRITE=0

# Optional. Per-request HTTP timeout in milliseconds. Defaults to 30000.
SLAB_MCP_TIMEOUT_MS=30000
