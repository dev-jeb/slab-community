# Your slab API key — app.slab.dev-jeb.com -> Account -> API Keys.
# Required. The server reads it from the environment only; it is never a tool
# argument, so a model can neither read it nor leak it into a transcript.
SLAB_API_KEY=sk_live_your_key_here

# Optional. Defaults to https://api.slab.dev-jeb.com
SLAB_API_URL=https://api.slab.dev-jeb.com

# Optional. The collector the key acts for. Omit and the server resolves your
# account's default collector once, on the first call that needs one.
SLAB_COLLECTOR=

# Optional. Unset/0 = read-only (the default). Set to 1 to also register the
# write tools (add/update/remove copies, log breaks and lots).
SLAB_MCP_WRITE=0

# Optional. Per-request HTTP timeout in milliseconds. Defaults to 30000.
SLAB_MCP_TIMEOUT_MS=30000
